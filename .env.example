PRIVATE_KEY=0xTU_CLAVE_PRIVADA_DE_TESTNET
ETHERSCAN_API_KEY=TU_API_KEY_DE_ETHERSCAN
ASSET_ADDRESS=
TREASURY_ADDRESS=
