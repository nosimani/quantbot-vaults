{
  "name": "quantbot-vaults",
  "version": "0.1.0",
  "description": "QuantBot Vaults - Protocolo de bóvedas automatizadas en Solidity para la ejecución segura de estrategias de trading algorítmico y bots en mercados Fintech on-chain",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "REPORT_GAS=true hardhat test",
    "slither": "slither . --config-file slither.config.json",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "demo:local": "hardhat run scripts/demo.js",
    "demo:sepolia": "hardhat run scripts/demo.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
